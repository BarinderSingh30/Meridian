# Copy this file to `.env` and fill in real values.
# See prisma/schema.prisma and lib/env.ts for how these are used.

# --- Database (Neon: https://neon.tech) ---
# Create a project, then a separate "dev" branch — point local .env at the
# dev branch so `prisma migrate reset` / reseed can never touch production.
# DATABASE_URL = pooled connection string (used by the app at runtime)
# DIRECT_URL   = unpooled connection string (used by the Prisma CLI for migrations)
DATABASE_URL=""
DIRECT_URL=""

# --- Auth.js (generate with `npx auth secret`) ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Google OAuth (Google Cloud Console) ---
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Resend (https://resend.com) ---
AUTH_RESEND_KEY=""
EMAIL_FROM=""

# --- Demo login (seeded accounts, for reviewers without their own OAuth) ---
DEMO_CUSTOMER_EMAIL="demo@example.com"
DEMO_CUSTOMER_PASSWORD=""
DEMO_ADMIN_EMAIL="admin-demo@example.com"
DEMO_ADMIN_PASSWORD=""

# --- Stripe (https://dashboard.stripe.com, test mode) ---
STRIPE_SECRET_KEY=""
# Local: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Prod: from the Stripe Dashboard webhook endpoint (different value!)
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (auto-injected on Vercel; `vercel env pull` locally) ---
BLOB_READ_WRITE_TOKEN=""
